<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Запуск команд в Termux (нужно выдать в настройках Android) -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- Голосовой ввод, камера и фото (разрешения запрашиваются при первом использовании) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Видимость пакета Termux и службы распознавания речи (Android 11+) -->
    <queries>
        <package android:name="com.termux" />
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:label="Kairema"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|smallestScreenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Файлы для «Поделиться» (только чтение, временная папка cache/share) -->
        <provider
            android:name=".share.ShareFiles"
            android:authorities="com.kairema.app.files"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Результаты команд от Termux -->
        <receiver
            android:name=".terminal.TermuxResultReceiver"
            android:exported="false" />
    </application>
</manifest>
