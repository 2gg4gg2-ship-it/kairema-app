<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Запуск команд в Termux (нужно выдать в настройках Android) -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- Камера и фото (разрешения запрашиваются при первом использовании) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Фоновая работа: ответ ИИ не обрывается при сворачивании -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Видимость пакета Termux (Android 11+) -->
    <queries>
        <package android:name="com.termux" />
    </queries>

    <application
        android:label="Kairema"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|smallestScreenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- «Поделиться» из других приложений: текст, ссылка, текстовый файл -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
            <!-- Пункт «Kairema» в меню выделенного текста -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Файлы для «Поделиться» (только чтение, временная папка cache/share) -->
        <provider
            android:name=".share.ShareFiles"
            android:authorities="com.kairema.app.files"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Результаты команд от Termux -->
        <receiver
            android:name=".terminal.TermuxResultReceiver"
            android:exported="false" />
        <service
            android:name=".service.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
